def json_ready(x):
    if isinstance(x, dict):
        return {str(k): json_ready(v) for k, v in x.items()}
    if isinstance(x, (list, tuple)):
        return [json_ready(v) for v in x]
    if isinstance(x, np.ndarray):
        return json_ready(x.tolist())
    if isinstance(x, np.generic):
        return json_ready(x.item())
    if isinstance(x, float) and not math.isfinite(x):
        return None
    return x


def write_json(path, obj):
    path = Path(path)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(json_ready(obj), ensure_ascii=False, indent=2), encoding="utf-8")
    os.replace(tmp, path)


def write_npz(path, **arrays):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    with tmp.open("wb") as f:
        np.savez_compressed(f, **arrays)
    os.replace(tmp, path)


def save_table(out, name, rows, keys=None):
    df = rows if isinstance(rows, pd.DataFrame) else pd.DataFrame(rows)
    path = Path(out) / name
    if keys and path.exists():
        prev = pd.read_csv(path)
        df = pd.concat([prev, df], ignore_index=True).drop_duplicates(keys, keep="last")
    tmp = path.with_name(path.name + ".tmp")
    df.to_csv(tmp, index=False, encoding="utf-8-sig")
    os.replace(tmp, path)
    return df


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def stream(seed, step, scale, replicate=0):
    """Independent RNG per (step, scale, replicate): split and joint runs agree."""
    return np.random.default_rng([int(seed), STEP_CODE[step], SCALE_CODE[scale], int(replicate)])


def mc_p(null, observed):
    """(b+1)/(B+1), one-sided on the statistic as given (Phipson & Smyth)."""
    a = np.asarray(null, float)
    if a.size == 0 or not np.isfinite(a).all() or not np.isfinite(observed):
        raise ValueError("invalid permutation statistics")
    return float((1 + np.count_nonzero(a >= observed)) / (len(a) + 1))


def mc_two_tail(null, observed):
    return min(1.0, 2 * min(mc_p(null, observed), mc_p(-np.asarray(null, float), -observed)))


def fisher_z(r1, n1, r2, n2):
    """Manuscript convention: SE from n-3 of valid transitions."""
    if min(n1, n2) < 4 or not (np.isfinite(r1) and np.isfinite(r2)):
        return float("nan"), float("nan")
    z = (math.atanh(r1) - math.atanh(r2)) / math.sqrt(1 / (n1 - 3) + 1 / (n2 - 3))
    return z, float(2 * stats.norm.sf(abs(z)))


# ----------------------------------------------------------------------------
# data
