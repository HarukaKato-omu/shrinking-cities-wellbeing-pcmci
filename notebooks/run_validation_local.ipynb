# steps
# ----------------------------------------------------------------------------
def step_networks(frame, out, scales):
    """All strata, three modes; Gate 2/3 sentinels under --window lag1."""
    rows, edges = [], []
    for scale in scales:
        for shrink in (None, True, False):
            for older in (False, True):
                base = stratum(frame, scale, older, shrink)
                for mode, sub in (("pooled", base), ("within", demean(base)), ("pooled_T3plus", restrict_min_waves(base))):
                    label = model_label(scale, older, shrink)
                    fit = cached_fit(sub, out, f"network_{scale}_{int(older)}_{shrink}_{mode}")
                    q = bh_qvalues_lag1(fit.p); sel = reported_edges(fit); st = out_strength(fit)
                    rows.append({"model": label, "mode": mode, "window": "strict3" if HISTORY == 2 else "lag1",
                                 "n_valid": fit.n, "n_edges": len(sel), "n_negative": sum(fit.val[i, j, 1] < 0 for i, j in sel),
                                 "LS_out_strength": st.get(HUB, 0.0), "LS_out_strength_loose": out_strength(fit, SENS_FLOOR).get(HUB, 0.0)})
                    for i, j in PAIR_INDEX:
                        edges.append({"model": label, "mode": mode, "source": S[i], "target": S[j], "MCI": fit.val[i, j, 1],
                                      "p": fit.p[i, j, 1], "q": q[i, j], "reported": (i, j) in sel, "n_valid": fit.n,
                                      "Z": "; ".join(zname(mci_conditioning_set(fit.parents, i, j)))})
                    if HISTORY == 1 and shrink is not False:
                        if mode == "pooled":
                            for (sc, ol, sh, dom), exp in TABLE5_SENTINELS.items():
                                if (sc, ol, sh) == (scale, older, shrink):
                                    got = st.get(dom, 0.0)
                                    print(f"  [gate 2] {label} {dom}: {got:.3f} vs {exp:.3f} [{'OK' if abs(got - exp) < 5e-4 else 'CHECK'}]", flush=True)
                        if mode == "within":
                            exp = WITHIN_PROFILE[(scale, older, shrink)]
                            print(f"  [gate 3] {label} within edges: {len(sel)} vs {exp} [{'OK' if len(sel) == exp else 'CHECK'}]", flush=True)
                    print(f"[networks] {label} / {mode}: n={fit.n}, edges={len(sel)}", flush=True)
    save_table(out, "N_network_summary.csv", rows, ["model", "mode"])
    save_table(out, "N_all_edges.csv", edges, ["model", "mode", "source", "target"])


def target_fits(analysis, out, scales):
    fits = {}
    for scale in scales:
        for shrink in (True, False, None):
            sub = demean(stratum(analysis, scale, True, shrink))
            fits[(scale, shrink)] = cached_fit(sub, out, f"target_{scale}_{shrink}_within")
    return fits


def step_diag_common(analysis, fits, out, scales):
    rows, waves, common, cond = [], [], [], {}
    for scale in scales:
        for shrink in (True, False):
            fit = fits[(scale, shrink)]; sub = fit.sub; label = model_label(scale, True, shrink)
            z = mci_conditioning_set(fit.parents, I, J)
            idx = valid_index(sub)
            T = sub.groupby("respondent_id").year.transform("size").to_numpy()[idx]
            rho = float(np.corrcoef(sub[CS], sub[WLB])[0, 1])
            r0, _ = parcorr_masked(sub, CS, WLB, [])
            rows.append({"model": label, "window": "strict3" if HISTORY == 2 else "lag1", "n_valid": fit.n,
                         "respondents_T3plus": sub.respondent_id.nunique(),
                         "n_lag1_pairs": len(valid_index(sub, 1)), "n_3year_windows": len(valid_index(sub, 2)),
                         **{f"transitions_T{t}": int((T == t).sum()) for t in range(3, 8)},
                         "mean_1_over_Tminus1": float(np.mean(1 / (T - 1))),
                         "rho_within_CS_WLB": rho, "iid_bivariate_artifact_heuristic": float(np.mean(-rho / (T - 1))),
                         "observed_bivariate_lagged_r": r0, "MCI_pipeline": float(fit.val[I, J, 1]),
                         "MCI_own_lag_WLB": float(fit.val[J, J, 1]), "MCI_own_lag_CS": float(fit.val[I, I, 1]),
                         "iid_null_own_lag": float(np.mean(-1 / (T - 1))), "n_conditioning": len(z)})
            dist = sub.groupby("respondent_id").size()
            for nw in range(3, 8):
                waves.append({"model": label, "wave_count": nw, "respondents": int((dist == nw).sum()),
                              "transitions": int((T == nw).sum())})
            cond[label] = {"parents_of_WLB": zname(fit.parents[J]), "parents_of_CS": zname(fit.parents[I]),
                           "MCI_conditioning_set_CS_to_WLB": zname(z)}
        fs, fn = fits[(scale, True)], fits[(scale, False)]
        zs, zn, zu = mci_conditioning_set(fs.parents, I, J), mci_conditioning_set(fn.parents, I, J), union_set(fs, fn)
        for name, za, zb in (("own (Table 7)", zs, zn), ("union (common)", zu, zu),
                             ("own lag only", [(J, -1)], [(J, -1)]), ("bivariate", [], [])):
            rs, ns = parcorr_masked(fs.sub, CS, WLB, za); rn, nn = parcorr_masked(fn.sub, CS, WLB, zb)
            z, pv = fisher_z(rs, fs.n, rn, fn.n)
            common.append({"scale": SLAB[scale], "conditioning": name, "shrinking_r": rs, "non_shrinking_r": rn,
                           "n_s": fs.n, "n_n": fn.n, "z": z, "p_iid": pv, "sets_identical": zs == zn,
                           "Z_s": "; ".join(zname(za)), "Z_n": "; ".join(zname(zb))})
    # wave-count distribution of respondents in all eight person-demeaned strata (Table S1, panel b)
    allw = []
    for scale in scales:
        for shrink in (None, True):
            for older in (False, True):
                sub = demean(stratum(analysis, scale, older, shrink))
                idx = valid_index(sub, 1)
                T = sub.groupby("respondent_id").year.transform("size").to_numpy()[idx]
                dist = sub.groupby("respondent_id").size()
                allw.append({"stratum": model_label(scale, older, shrink), "respondents_T3plus": int(dist.size),
                             "transitions": int(len(idx)),
                             **{f"respondents_T{t}": int((dist == t).sum()) for t in range(3, 8)},
                             **{f"transitions_T{t}": int((T == t).sum()) for t in range(3, 8)},
                             "mean_1_over_Tminus1": float(np.mean(1 / (T - 1)))})
    save_table(out, "V1_diagnostics.csv", rows, ["model"])
    save_table(out, "V1_wave_distribution.csv", waves, ["model", "wave_count"])
    save_table(out, "V1_wave_distribution_all_strata.csv", allw, ["stratum"])
    save_table(out, "V2_common_set.csv", common, ["scale", "conditioning"])
    path = Path(out) / "V1_conditioning_sets.json"
    prev = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
    prev.update(cond); write_json(path, prev)


def step_boot(fits, out, scales, nboot, seed):
    rows = []
    for scale in scales:
        fs, fn = fits[(scale, True)], fits[(scale, False)]
        designs = {}
        for conv in ("own", "union"):
            pair = []
            for f, other in ((fs, fn), (fn, fs)):
                z = mci_conditioning_set(f.parents, I, J) if conv == "own" else union_set(fs, fn)
                a, idx = aligned_array(f.sub, I, J, z)
                muni = f.sub.muni_code.to_numpy()[idx]          # cluster = municipality at t
                blocks = [np.flatnonzero(muni == g) for g in np.unique(muni)]
                pair.append((a, blocks))
            designs[conv] = pair
        for conv, pair in designs.items():
            (a_s, b_s), (a_n, b_n) = pair
            rs, rn = partial_corr_array(a_s), partial_corr_array(a_n)
            obs = math.atanh(rs) - math.atanh(rn)
            diffs = np.empty(nboot)
            for b in range(nboot):
                rng = stream(seed, "boot", scale, b)
                bs = a_s[np.concatenate([b_s[k] for k in rng.integers(0, len(b_s), len(b_s))])]
                bn = a_n[np.concatenate([b_n[k] for k in rng.integers(0, len(b_n), len(b_n))])]
                diffs[b] = math.atanh(partial_corr_array(bs)) - math.atanh(partial_corr_array(bn))
            se = float(diffs.std(ddof=1)); se_naive = math.sqrt(1 / (fs.n - 3) + 1 / (fn.n - 3))
            rows.append({"scale": SLAB[scale], "convention": conv, "r_s": rs, "r_n": rn, "diff_fisher_scale": obs,
                         "se_naive": se_naive, "se_cluster_boot": se, "se_ratio": se / se_naive,
                         "z_naive": obs / se_naive, "z_cluster_boot": obs / se,
                         "p_cluster_boot_wald": float(2 * stats.norm.sf(abs(obs / se))),
                         "boot_ci95_lo": float(np.quantile(diffs, .025)), "boot_ci95_hi": float(np.quantile(diffs, .975)),
                         "n_munis_s": len(b_s), "n_munis_n": len(b_n), "nboot": nboot})
            print(f"[V4 {scale} {conv}] z naive {obs / se_naive:.2f} -> cluster {obs / se:.2f}", flush=True)
    save_table(out, "V4_cluster_boot.csv", rows, ["scale", "convention"])


def permute_within_person(sub, rng):
    d = sub.copy()
    a = d[S].to_numpy(float).copy(); ids = d.respondent_id.to_numpy()
    starts = np.r_[0, np.where(ids[1:] != ids[:-1])[0] + 1, len(d)]
    for s, e in zip(starts[:-1], starts[1:]):
        if e - s > 1:
            a[s:e] = a[s:e][rng.permutation(e - s)]
    d[S] = a
    return d


def step_perm_time(analysis, fits, out, scales, nrep, seed):
    results = {}
    for scale in scales:
        fs, fn, fa = fits[(scale, True)], fits[(scale, False)], fits[(scale, None)]
        obs, Zp_obs, Zu_obs = contrast_metrics(fs, fn)
        base_s = restrict_min_waves(stratum(analysis, scale, True, True))
        base_n = restrict_min_waves(stratum(analysis, scale, True, False))
        rows, ms, mn, ma, zp, zu = [], [], [], [], [], []
        t0 = time.time()
        for b in range(nrep):
            if REP_RANGE and not (REP_RANGE[0] <= b < REP_RANGE[1]):
                continue
            path = Path(out) / "checkpoints" / f"V3_{scale}" / f"{b:06d}.npz"
            if path.exists():
                with np.load(path, allow_pickle=False) as a:
                    row = json.loads(str(a["row"])); vs, vn, va, Zp, Zu = a["s"], a["n"], a["all"], a["zp"], a["zu"]
            else:
                rng = stream(seed, "perm_time", scale, b)
                ps, pn = permute_within_person(base_s, rng), permute_within_person(base_n, rng)
                pa = pd.concat([ps, pn]).sort_values(["respondent_id", "year"]).reset_index(drop=True)
                bs, bn, ba = run_model_with_parents(demean(ps)), run_model_with_parents(demean(pn)), run_model_with_parents(demean(pa))
                row, Zp, Zu = contrast_metrics(bs, bn)
                vs, vn, va = bs.val[:14, :14, 1], bn.val[:14, :14, 1], ba.val[:14, :14, 1]
                write_npz(path, row=np.asarray(json.dumps(json_ready(row))), s=vs, n=vn, all=va, zp=Zp, zu=Zu)
            rows.append(row); ms.append(vs); mn.append(vn); ma.append(va); zp.append(Zp); zu.append(Zu)
            if (b + 1) % 25 == 0 or b == nrep - 1:
                print(f"[V3 {scale}] {b + 1}/{nrep} ({time.time() - t0:.0f}s)", flush=True)
        if REP_RANGE:
            print(f"[V3 {scale}] worker slice {REP_RANGE} done; run without --rep-range to aggregate", flush=True)
            continue
        null = pd.DataFrame(rows)
        save_table(out, f"V3_perm_time_{scale}.csv", null)
        write_npz(Path(out) / f"V3_perm_time_{scale}_matrices.npz", shrinking=np.asarray(ms), non_shrinking=np.asarray(mn),
                  all=np.asarray(ma), z_paper=np.asarray(zp), z_union=np.asarray(zu),
                  observed_shrinking=fs.val[:14, :14, 1], observed_non_shrinking=fn.val[:14, :14, 1],
                  observed_all=fa.val[:14, :14, 1], observed_z_paper=Zp_obs, observed_z_union=Zu_obs, var_names=np.asarray(S))
        edges = []
        for label, fit, values in (("shrinking", fs, np.asarray(ms)), ("non_shrinking", fn, np.asarray(mn)), ("all", fa, np.asarray(ma))):
            sel = set(reported_edges(fit))
            for i, j in PAIR_INDEX:
                nd = values[:, i, j]; o = float(fit.val[i, j, 1])
                edges.append({"scale": SLAB[scale], "model": f"{label} 65+", "source": S[i], "target": S[j], "reported": (i, j) in sel,
                              "mci_obs": o, "null_mean": float(nd.mean()), "null_q025": float(np.quantile(nd, .025)),
                              "null_q975": float(np.quantile(nd, .975)), "null_centred_mci": float(o - nd.mean()),
                              "perm_p_two_tail": mc_two_tail(nd, o)})
        save_table(out, f"V3_table6_edges_vs_null_{scale}.csv", edges)
        res = {"nrep": nrep, "window": "strict3" if HISTORY == 2 else "lag1", "observed": obs,
               "null_q025_q50_q975": {c: [float(x) for x in null[c].quantile([.025, .5, .975])] for c in null.columns},
               "null_mean_reported_edges_s": float(null["paper__n_reported_edges_s"].mean()),
               "null_share_reps_with_reported_edge_s": float((null["paper__n_reported_edges_s"] > 0).mean()),
               **perm_pvalues(null, obs, "")}
        write_json(Path(out) / f"V3_perm_time_{scale}.json", res); results[scale] = res
    return results


def label_groups(base, mode):
    flags = base.groupby("muni_code").shrinking.first().astype(int)
    codes = flags.index.to_numpy()
    if mode == "global":
        block = np.repeat("all", len(codes))
    elif mode == "prefecture":
        block = flags.index.str[:2].to_numpy()
    elif mode == "region":
        block = np.asarray([region_of(c[:2]) for c in codes])
    else:
        raise ValueError(mode)
    groups, mixed, log10_assign = [], 0, 0.0
    for name in sorted(set(block)):
        c = codes[block == name]; k = int(flags.loc[c].sum())
        groups.append((c, k))
        if 0 < k < len(c):
            mixed += 1
            log10_assign += (gammaln(len(c) + 1) - gammaln(k + 1) - gammaln(len(c) - k + 1)) / math.log(10)
    return groups, {"n_blocks": len(groups), "n_mixed_blocks": mixed, "n_municipalities": len(codes),
                    "n_shrinking_municipalities": int(flags.sum()), "log10_distinct_assignments": log10_assign}


def step_perm_label(analysis, fits, out, scales, nrep, seed, modes):
    results = {}
    for scale in scales:
        fs, fn = fits[(scale, True)], fits[(scale, False)]
        obs, Zp_obs, Zu_obs = contrast_metrics(fs, fn)
        base = restrict_min_waves(stratum(analysis, scale, True, None))
        for mode in modes:
            groups, diag = label_groups(base, mode)
            if diag["n_mixed_blocks"] == 0:
                print(f"[V6 {scale} {mode}] no mixed blocks; skipped", flush=True); continue
            rows, zp, zu = [], [], []
            t0 = time.time()
            for b in range(nrep):
                if REP_RANGE and not (REP_RANGE[0] <= b < REP_RANGE[1]):
                    continue
                path = Path(out) / "checkpoints" / f"V6_{scale}_{mode}" / f"{b:06d}.npz"
                if path.exists():
                    with np.load(path, allow_pickle=False) as a:
                        row = json.loads(str(a["row"])); Zp, Zu = a["zp"], a["zu"]
                else:
                    rng = stream(seed, "perm_label", scale, b * 10 + {"global": 0, "region": 1, "prefecture": 2}[mode])
                    picked = set()
                    for c, k in groups:
                        picked.update(rng.choice(c, size=k, replace=False))
                    flag = base.muni_code.isin(picked).to_numpy()
                    bs = run_model_with_parents(demean(base[flag].reset_index(drop=True)))
                    bn = run_model_with_parents(demean(base[~flag].reset_index(drop=True)))
                    row, Zp, Zu = contrast_metrics(bs, bn)
                    write_npz(path, row=np.asarray(json.dumps(json_ready(row))), zp=Zp, zu=Zu)
                rows.append(row); zp.append(Zp); zu.append(Zu)
                if (b + 1) % 25 == 0 or b == nrep - 1:
                    print(f"[V6 {scale} {mode}] {b + 1}/{nrep} ({time.time() - t0:.0f}s)", flush=True)
            if REP_RANGE:
                print(f"[V6 {scale} {mode}] worker slice {REP_RANGE} done; run without --rep-range to aggregate", flush=True)
                continue
            null = pd.DataFrame(rows)
            save_table(out, f"V6_perm_label_{scale}_{mode}.csv", null)
            write_npz(Path(out) / f"V6_perm_label_{scale}_{mode}_zmatrices.npz", z_paper=np.asarray(zp), z_union=np.asarray(zu),
                      observed_z_paper=Zp_obs, observed_z_union=Zu_obs, var_names=np.asarray(S))
            res = {"nrep": nrep, "label_blocks": mode, "window": "strict3" if HISTORY == 2 else "lag1", "blocks": diag, "observed": obs,
                   "null_q025_q50_q975": {c: [float(x) for x in null[c].quantile([.025, .5, .975])] for c in null.columns},
                   **perm_pvalues(null, obs, "")}
            write_json(Path(out) / f"V6_perm_label_{scale}_{mode}.json", res); results[(scale, mode)] = res
    return results


def ah_design(sub, time_controls):
    d = sub.sort_values(["respondent_id", "year"]).reset_index(drop=True)
    t = valid_index(d, 2)                                   # AH needs t, t-1, t-2 by construction
    y, x = d[WLB].to_numpy(float), d[CS].to_numpy(float)
    dep = y[t] - y[t - 1]
    endog = np.column_stack([y[t - 1] - y[t - 2], x[t - 1] - x[t - 2]])
    if time_controls == "year_fe":
        years = d.year.to_numpy()[t]; lv = sorted(np.unique(years))
        exog = np.column_stack([np.ones(len(t))] + [(years == yr).astype(float) for yr in lv[1:]])
    else:
        covid = d.year.isin(COVID_YEARS).to_numpy(float)
        exog = np.column_stack([np.ones(len(t)), covid[t] - covid[t - 1]])
        if np.linalg.matrix_rank(exog) < exog.shape[1]:
            exog = exog[:, :1]
    instr = np.column_stack([y[t - 2], x[t - 2]])
    return dep, endog, exog, instr, d.muni_code.to_numpy()[t], d.respondent_id.to_numpy()[t]


def cluster_cov(design, resid, cluster, bread):
    """CR1 cluster-robust covariance (vectorised over clusters)."""
    n, k = design.shape
    _, inv = np.unique(cluster, return_inverse=True); g = inv.max() + 1
    scores = np.zeros((g, k)); np.add.at(scores, inv, design * resid[:, None])
    return bread @ (scores.T @ scores) @ bread.T * (g / (g - 1)) * ((n - 1) / (n - k))


def tsls_cluster(dep, endog, exog, instr, cluster):
    xr = np.column_stack([endog, exog]); zi = np.column_stack([instr, exog])
    px = zi @ np.linalg.lstsq(zi, xr, rcond=None)[0]
    cross = px.T @ xr
    b = np.linalg.solve(cross, px.T @ dep); u = dep - xr @ b
    v = cluster_cov(px, u, cluster, np.linalg.inv(cross))
    F = []
    for c in range(endog.shape[1]):
        yy = endog[:, c]
        rss = float(((yy - zi @ np.linalg.lstsq(zi, yy, rcond=None)[0]) ** 2).sum())
        rss0 = float(((yy - exog @ np.linalg.lstsq(exog, yy, rcond=None)[0]) ** 2).sum())
        F.append(((rss0 - rss) / instr.shape[1]) / (rss / (len(yy) - zi.shape[1])))
    return b, np.sqrt(np.maximum(np.diag(v), 0)), F, len(dep), len(np.unique(cluster))


def step_ahiv(analysis, out, scales):
    rows = []
    for scale in scales:
        for spec in ("year_fe", "covid_difference"):
            est = {}
            for shrink in (True, False):
                sub = stratum(analysis, scale, True, shrink)
                dep, endog, exog, instr, muni, rid = ah_design(sub, spec)
                b, se, F, n, g = tsls_cluster(dep, endog, exog, instr, muni)
                est[shrink] = (b[1], se[1], g)
                rows.append({"scale": SLAB[scale], "specification": spec, "subset": "shrinking" if shrink else "non-shrinking",
                             "n_equations": n, "n_respondents": len(np.unique(rid)), "n_munis": g,
                             "gamma_CS_to_WLB": b[1], "se_cluster_muni": se[1],
                             "p_cluster_t": float(2 * stats.t.sf(abs(b[1] / se[1]), g - 1)),
                             "gamma_standardised": b[1] * endog[:, 1].std() / dep.std(),
                             "beta_own_lag_WLB": b[0], "first_stage_F_dWLB": F[0], "first_stage_F_dCS": F[1]})
            (gs, ss, g1), (gn, sn, g2) = est[True], est[False]
            se = math.sqrt(ss ** 2 + sn ** 2)
            df = (ss ** 2 + sn ** 2) ** 2 / (ss ** 4 / (g1 - 1) + sn ** 4 / (g2 - 1))
            rows.append({"scale": SLAB[scale], "specification": spec, "subset": "difference (shrinking - non-shrinking)",
                         "gamma_CS_to_WLB": gs - gn, "se_cluster_muni": se,
                         "p_cluster_t": float(2 * stats.t.sf(abs((gs - gn) / se), df)), "df_welch": df})
            print(f"[V5 {scale} {spec}] gamma shrink {gs:+.3f} ({ss:.3f}) vs non {gn:+.3f} ({sn:.3f})", flush=True)
    save_table(out, "V5_anderson_hsiao.csv", rows, ["scale", "specification", "subset"])


def step_window_check(analysis, out, scales):
    """Target coefficients under both windows, without touching the primary fits."""
    global HISTORY
    primary = HISTORY
    rows = []
    for hist, wname in ((1, "lag1"), (2, "strict3")):
        HISTORY = hist
        for scale in scales:
            f = {}
            for shrink in (True, False):
                sub = demean(stratum(analysis, scale, True, shrink))
                f[shrink] = cached_fit(sub, out, f"window_{wname}_{scale}_{shrink}_within")
            fs, fn = f[True], f[False]
            z, pv = fisher_z(fs.val[I, J, 1], fs.n, fn.val[I, J, 1], fn.n)
            rows.append({"scale": SLAB[scale], "window": wname, "n_s": fs.n, "n_n": fn.n,
                         "mci_s": float(fs.val[I, J, 1]), "mci_n": float(fn.val[I, J, 1]), "z_paper": z, "p_iid": pv,
                         "Z_s": "; ".join(zname(mci_conditioning_set(fs.parents, I, J))),
                         "Z_n": "; ".join(zname(mci_conditioning_set(fn.parents, I, J))),
                         "reported_edges_s": "; ".join(f"{S[i]}->{S[j]}" for i, j in reported_edges(fs))})
            print(f"[V7 {scale} {wname}] n {fs.n}/{fn.n}, MCI {fs.val[I, J, 1]:+.3f}/{fn.val[I, J, 1]:+.3f}, z {z:.2f}", flush=True)
    HISTORY = primary
    save_table(out, "V7_window_sensitivity.csv", rows, ["scale", "window"])


def step_period_check(fits, out, scales):
    """V8: the target partial correlation, with each subset's OWN lag1
    conditioning set held fixed, on (a) all lag-1 transitions, (b) transitions
    with a 3-year history ('later'), (c) first transitions of each consecutive
    run, and (d) transitions by calendar year of t.  Explains any difference
    between the lag1 and strict3 windows (V7): position in the run vs period."""
    rows, contrasts = [], []
    for scale in scales:
        parts = {}
        for shrink in (True, False):
            f = fits[(scale, shrink)]; d = f.sub
            Z = mci_conditioning_set(f.parents, I, J)
            idx1 = valid_index(d, 1); idx1 = idx1[idx1 - 2 >= 0]
            later = np.isin(idx1, valid_index(d, 2))
            years = d.year.to_numpy()[idx1]
            vals = d[ALL].to_numpy(float)
            A = np.column_stack([vals[idx1 + lag, k] for k, lag in [(I, -1), (J, 0)] + list(Z)])
            groups = {"all lag1": np.ones(len(idx1), bool), "later (3-year history)": later, "first transitions": ~later}
            groups.update({f"transition to {int(y)}": years == y for y in sorted(np.unique(years))})
            for name, m in groups.items():
                n = int(m.sum())
                r = partial_corr_array(A[m]) if n > len(Z) + 10 else float("nan")
                rb = partial_corr_array(A[m][:, :2]) if n > 10 else float("nan")
                parts[(shrink, name)] = (r, n)
                rows.append({"scale": SLAB[scale], "subset": "shrinking" if shrink else "non-shrinking", "rows": name,
                             "n": n, "share_first_transitions": float((~later[m]).mean()) if n else float("nan"),
                             "MCI_fixed_own_Z": r, "bivariate_r": rb})
        for name in {k[1] for k in parts}:
            (rs, ns), (rn, nn) = parts[(True, name)], parts[(False, name)]
            z, p = fisher_z(rs, ns, rn, nn)
            contrasts.append({"scale": SLAB[scale], "rows": name, "mci_s": rs, "n_s": ns, "mci_n": rn, "n_n": nn, "z_paper": z, "p_iid": p})
    save_table(out, "V8_period_position.csv", rows, ["scale", "subset", "rows"])
    save_table(out, "V8_period_position_contrasts.csv", contrasts, ["scale", "rows"])
    for c in contrasts:
        if c["rows"] in ("all lag1", "later (3-year history)", "first transitions"):
            print(f"[V8 {c['scale']}] {c['rows']:24s} z {c['z_paper']:+.2f} (s {c['mci_s']:+.3f} n={c['n_s']}, n {c['mci_n']:+.3f} n={c['n_n']})", flush=True)


def _ols_cluster(y, X, cluster):
    """OLS with municipality-cluster-robust covariance (CR1)."""
    XtX_inv = np.linalg.inv(X.T @ X)
    b = XtX_inv @ X.T @ y
    u = y - X @ b
    V = cluster_cov(X, u, cluster, XtX_inv)
    return b, np.sqrt(np.maximum(np.diag(V), 0)), V


def _dose_design(sub, r_centre=0.0):
    """Within-person (demeaned) design on valid lag-1 transitions:
    y=WLB(t), x=CS(t-1), y1=WLB(t-1), r=municipal annual change rate (%/yr)
    at t, year dummies. Returns dict of arrays."""
    d = demean(sub)
    idx = valid_index(d, 1)
    y = d[WLB].to_numpy(float)[idx]; x = d[CS].to_numpy(float)[idx - 1]; y1 = d[WLB].to_numpy(float)[idx - 1]
    r = 100.0 * d["annual_change_rate"].to_numpy(float)[idx] - r_centre
    yrs = d.year.to_numpy()[idx]; lv = sorted(np.unique(yrs))
    year_fe = np.column_stack([(yrs == v).astype(float) for v in lv[1:]]) if len(lv) > 1 else np.empty((len(idx), 0))
    return {"y": y, "x": x, "y1": y1, "r": r, "year_fe": year_fe, "muni": d.muni_code.to_numpy()[idx],
            "rid": d.respondent_id.to_numpy()[idx], "shrink": d.shrinking.to_numpy()[idx], "n": len(idx),
            "scale": d.city_scale.to_numpy()[idx]}


def _fit_interaction(D, extra=None):
    """y = b0 + b1 x + b2 y1 + b3 (x*r) + b4 (y1*r) + b5 r + year FE [+ extra]; returns b, se, X."""
    cols = [np.ones(D["n"]), D["x"], D["y1"], D["x"] * D["r"], D["y1"] * D["r"], D["r"]]
    names = ["const", "CS(t-1)", "WLB(t-1)", "CS(t-1) x rate", "WLB(t-1) x rate", "rate"]
    X = np.column_stack(cols + [D["year_fe"]] + ([extra] if extra is not None else []))
    b, se, V = _ols_cluster(D["y"], X, D["muni"])
    return b, se, V, names


def step_dose_response(analysis, out, scales, seed, nperm=2000):
    """V9: continuous moderation of the within-person CS(t-1) -> WLB(t)
    dependency by the municipal annual population change rate (dose-response),
    replacing the binary shrinking / non-shrinking split.  OLS on person-demeaned
    scores with the target's own lag (the MCI conditioning that cancels the
    short-panel artifact), year fixed effects, municipality-cluster SEs,
    randomisation inference by permuting the rate across municipalities, an
    Anderson-Hsiao IV version, and a binned (quintile) partial-correlation profile."""
    rows, bins = [], []
    rng = np.random.default_rng([int(seed), 9])
    groups = [(sc, True) for sc in scales] + [(sc, False) for sc in scales]
    if set(scales) == set(SCALES_ALL):
        groups += [("pooled", True), ("pooled", False)]
    for scale, older in groups:
        sub = stratum(analysis, None if scale == "pooled" else scale, older, None)
        D = _dose_design(sub)
        extra = None
        if scale == "pooled":                       # scale main effect and scale x CS(t-1)
            large = (D["scale"] == "Large").astype(float)
            extra = np.column_stack([large, large * D["x"]])
        b, se, V, names = _fit_interaction(D, extra)
        k = names.index("CS(t-1) x rate"); G = len(np.unique(D["muni"]))
        t_obs = b[k] / se[k]
        # randomisation inference: permute the municipal rate across municipalities (within scale)
        codes, inv = np.unique(D["muni"], return_inverse=True)
        muni_rate = np.zeros(len(codes)); muni_rate[inv] = D["r"]
        muni_scale = np.empty(len(codes), dtype=object); muni_scale[inv] = D["scale"]
        blocks = [np.flatnonzero(muni_scale == sc) for sc in np.unique(muni_scale)]
        tnull = np.empty(nperm)
        for p in range(nperm):
            perm = muni_rate.copy()
            for m in blocks:
                perm[m] = muni_rate[m][rng.permutation(len(m))]
            Dp = dict(D); Dp["r"] = perm[inv]
            bp, sep, _, _ = _fit_interaction(Dp, extra)
            tnull[p] = bp[k] / sep[k]
        p_ri = mc_p(np.abs(tnull), abs(t_obs))
        # implied slope of CS(t-1) at rate quantiles (pooled: at Large=0 baseline)
        j = names.index("CS(t-1)")
        qs = np.quantile(D["r"], [.10, .25, .50, .75, .90])
        slopes = {}
        for q, rv in zip((10, 25, 50, 75, 90), qs):
            g = np.zeros(len(b)); g[j] = 1; g[k] = rv
            sl = float(g @ b); sl_se = float(np.sqrt(g @ V @ g))
            slopes[f"slope_at_r_p{q}"] = sl; slopes[f"slope_se_p{q}"] = sl_se; slopes[f"r_p{q}"] = float(rv)
        rows.append({"scale": scale, "cohort": "65+" if older else "15-64", "estimator": "within OLS (own lag, year FE)",
                     "n_transitions": D["n"], "n_munis": G, "n_respondents": len(np.unique(D["rid"])),
                     "beta_CS": b[j], "se_CS": se[j], "beta_interaction": b[k], "se_interaction": se[k],
                     "t_cluster": t_obs, "p_cluster_t": float(2 * stats.t.sf(abs(t_obs), G - 1)),
                     "p_randomisation": p_ri, "nperm": nperm, **slopes})
        print(f"[V9 {scale} {'65+' if older else '15-64'}] CS x rate = {b[k]:+.4f} (se {se[k]:.4f}), t {t_obs:+.2f}, "
              f"cluster p {2 * stats.t.sf(abs(t_obs), G - 1):.3f}, RI p {p_ri:.3f}; slope at r p10/p50/p90 = "
              f"{slopes['slope_at_r_p10']:+.3f}/{slopes['slope_at_r_p50']:+.3f}/{slopes['slope_at_r_p90']:+.3f}", flush=True)
        # Anderson-Hsiao IV with interaction (levels, first differences, t-2 instruments)
        d = sub.sort_values(["respondent_id", "year"]).reset_index(drop=True)
        t = valid_index(d, 2)
        yv, xv = d[WLB].to_numpy(float), d[CS].to_numpy(float)
        rv = 100.0 * d["annual_change_rate"].to_numpy(float)[t]
        dep = yv[t] - yv[t - 1]
        dx = xv[t - 1] - xv[t - 2]
        endog = np.column_stack([yv[t - 1] - yv[t - 2], dx, dx * rv])
        yrs = d.year.to_numpy()[t]; lv = sorted(np.unique(yrs))
        exog = np.column_stack([np.ones(len(t)), rv] + [(yrs == v).astype(float) for v in lv[1:]])
        if scale == "pooled":
            large = (d.city_scale.to_numpy()[t] == "Large").astype(float)
            exog = np.column_stack([exog, large])
        instr = np.column_stack([yv[t - 2], xv[t - 2], xv[t - 2] * rv, yv[t - 2] * rv])
        try:
            bb, ss, F, n, g = tsls_cluster(dep, endog, exog, instr, d.muni_code.to_numpy()[t])
            rows.append({"scale": scale, "cohort": "65+" if older else "15-64", "estimator": "Anderson-Hsiao IV (year FE)",
                         "n_transitions": n, "n_munis": g, "beta_CS": bb[1], "se_CS": ss[1],
                         "beta_interaction": bb[2], "se_interaction": ss[2], "t_cluster": bb[2] / ss[2],
                         "p_cluster_t": float(2 * stats.t.sf(abs(bb[2] / ss[2]), g - 1)),
                         "first_stage_F_dCS": F[1], "first_stage_F_dCSxrate": F[2]})
            print(f"[V9 {scale} {'65+' if older else '15-64'}] AH-IV CS x rate = {bb[2]:+.4f} (se {ss[2]:.4f}), t {bb[2] / ss[2]:+.2f}", flush=True)
        except Exception as e:                         # rank problems in small strata
            print(f"[V9 {scale}] AH-IV skipped: {e}", flush=True)
        # binned profile: partial correlation given WLB(t-1) and CS(t-2) within rate quintiles (65+ only)
        if older and scale != "pooled":
            dd = demean(sub); vals = dd[ALL].to_numpy(float)
            idx = valid_index(dd, 1); idx = idx[idx - 2 >= 0]
            rr = 100.0 * dd["annual_change_rate"].to_numpy(float)[idx]
            edges_q = np.quantile(rr, [0, .2, .4, .6, .8, 1.0])
            A = np.column_stack([vals[idx - 1, ALL.index(CS)], vals[idx, ALL.index(WLB)],
                                 vals[idx - 1, ALL.index(WLB)], vals[idx - 2, ALL.index(CS)]])
            for q in range(5):
                m = (rr >= edges_q[q]) & (rr <= edges_q[q + 1]) if q == 4 else (rr >= edges_q[q]) & (rr < edges_q[q + 1])
                bins.append({"scale": scale, "quintile": q + 1, "rate_lo": edges_q[q], "rate_hi": edges_q[q + 1],
                             "rate_median": float(np.median(rr[m])), "n": int(m.sum()),
                             "partial_r_CS_to_WLB": partial_corr_array(A[m]) if m.sum() > 20 else float("nan")})
    save_table(out, "V9_dose_response.csv", rows, ["scale", "cohort", "estimator"])
    if bins:
        save_table(out, "V9_dose_response_bins.csv", bins, ["scale", "quintile"])


def step_dose_extra(analysis, out, scales, seed, nperm=2000):
    """V9 figure inputs (Figure 4) and region robustness (Table 8 note).
    (a) V9_figure4_lines.json: implied CS(t-1) coefficient b_CS + b_int * r over a
        grid of rates with its delta-method SE, for the pooled 65+ and 15-64 models
        (large-city indicator at the SMC reference level); r_range = central 98%.
    (b) V9_figure4_quintile_slopes.csv: the within OLS slope of CS(t-1) (own lag,
        year FE, municipality-cluster SE) estimated separately within quintiles of
        the rate, 65+ by city scale.
    (c) V9_dose_response_region.csv: the interaction with region fixed effects and
        region x CS(t-1) added, and randomisation inference with the rate reassigned
        within scale x region blocks.  Uses its own RNG stream, so the V9 results of
        step_dose_response are unchanged."""
    if set(scales) != set(SCALES_ALL):
        print("[V9 extra] requires --scales SMC,Large; skipped", flush=True); return
    rng = np.random.default_rng([int(seed), 9, 3])
    grid = np.round(np.arange(-3.0, 2.2001, 0.05), 2)
    lines, region_rows, qrows = {}, [], []
    for scale, older in (("pooled", True), ("pooled", False), ("SMC", True), ("Large", True)):
        sub = stratum(analysis, None if scale == "pooled" else scale, older, None)
        D = _dose_design(sub)
        extra = None
        if scale == "pooled":
            large = (D["scale"] == "Large").astype(float)
            extra = np.column_stack([large, large * D["x"]])
        b, se, V, names = _fit_interaction(D, extra)
        j, k = names.index("CS(t-1)"), names.index("CS(t-1) x rate")
        if scale == "pooled":                                   # (a) fitted lines
            Gm = np.column_stack([np.ones_like(grid), grid])
            cov = np.array([[V[j, j], V[j, k]], [V[k, j], V[k, k]]])
            lines["65+" if older else "15-64"] = {
                "b_cs": float(b[j]), "b_int": float(b[k]), "se_int": float(se[k]),
                "grid": grid.tolist(), "slope": (b[j] + b[k] * grid).tolist(),
                "se": np.sqrt(np.einsum("ij,jk,ik->i", Gm, cov, Gm)).tolist(),
                "r_range": [float(np.quantile(D["r"], .01)), float(np.quantile(D["r"], .99))]}
        if not older:
            continue
        # (c) region robustness, 65+ only
        region = np.array([region_of(str(m)[:2]) for m in D["muni"]])
        regs = sorted(set(region)); R = np.column_stack([(region == r).astype(float) for r in regs[1:]])
        extra2 = np.column_stack([R, R * D["x"][:, None]] + ([extra] if extra is not None else []))
        b2, se2, _, _ = _fit_interaction(D, extra2)
        G = len(np.unique(D["muni"])); t_obs = b[k] / se[k]
        codes, inv = np.unique(D["muni"], return_inverse=True)
        muni_rate = np.zeros(len(codes)); muni_rate[inv] = D["r"]
        key = np.empty(len(codes), dtype=object); key[inv] = [f"{s}|{r}" for s, r in zip(D["scale"], region)]
        blocks = [np.flatnonzero(key == u) for u in np.unique(key)]
        tnull = np.empty(nperm)
        for p in range(nperm):
            perm = muni_rate.copy()
            for m in blocks:
                perm[m] = muni_rate[m][rng.permutation(len(m))]
            Dp = dict(D); Dp["r"] = perm[inv]
            bp, sp, _, _ = _fit_interaction(Dp, extra)
            tnull[p] = bp[k] / sp[k]
        region_rows.append({"scale": scale, "cohort": "65+", "n_transitions": D["n"], "n_munis": G, "n_regions": len(regs),
                            "beta_interaction": b[k], "se_interaction": se[k], "p_cluster_t": float(2 * stats.t.sf(abs(t_obs), G - 1)),
                            "beta_interaction_region_FE": b2[k], "se_region_FE": se2[k],
                            "p_cluster_t_region_FE": float(2 * stats.t.sf(abs(b2[k] / se2[k]), G - 1)),
                            "p_randomisation_region_blocks": mc_p(np.abs(tnull), abs(t_obs)), "n_blocks": len(blocks), "nperm": nperm})
        print(f"[V9 region {scale} 65+] interaction {b[k]:+.4f} -> with region FE x CS {b2[k]:+.4f} (se {se2[k]:.4f}, "
              f"p {region_rows[-1]['p_cluster_t_region_FE']:.3f}); region-blocked RI p {region_rows[-1]['p_randomisation_region_blocks']:.3f}", flush=True)
        if scale == "pooled":
            continue
        # (b) quintile slopes, 65+ by scale: same within specification without the interaction
        rr = D["r"]; edges_q = np.quantile(rr, [0, .2, .4, .6, .8, 1.0])
        for q in range(5):
            m = (rr >= edges_q[q]) & (rr <= edges_q[q + 1]) if q == 4 else (rr >= edges_q[q]) & (rr < edges_q[q + 1])
            yrs_fe = D["year_fe"][m]; yrs_fe = yrs_fe[:, yrs_fe.any(axis=0)]
            X = np.column_stack([np.ones(int(m.sum())), D["x"][m], D["y1"][m], yrs_fe])
            bq, sq, _ = _ols_cluster(D["y"][m], X, D["muni"][m])
            qrows.append({"scale": scale, "quintile": q + 1, "rate_lo": float(edges_q[q]), "rate_hi": float(edges_q[q + 1]),
                          "rate_median": float(np.median(rr[m])), "n": int(m.sum()), "n_munis": int(len(np.unique(D["muni"][m]))),
                          "slope_CS": float(bq[1]), "se_cluster": float(sq[1])})
    write_json(Path(out) / "V9_figure4_lines.json", lines)
    save_table(out, "V9_figure4_quintile_slopes.csv", qrows, ["scale", "quintile"])
    save_table(out, "V9_dose_response_region.csv", region_rows, ["scale", "cohort"])


def step_dose_family(analysis, out, scales, seed, nperm=500):
    """V9b: selection-adjusted inference for the rate interaction.  The same
    within-OLS interaction model is fitted for ALL 182 directed lagged edges
    (source(t-1) x rate -> target(t), with the target's own lag and year FE);
    the CS -> WLB interaction |t| (classical OLS t, used consistently for the
    observed and permuted data) is ranked among the 182, and a randomisation
    family p is obtained by permuting the rate across municipalities and taking
    max |t| over the 182 edges (and over the CS13 family)."""
    rng = np.random.default_rng([int(seed), 9, 2])
    rows = []
    groups = [(sc, True) for sc in scales] + ([("pooled", True)] if set(scales) == set(SCALES_ALL) else [])
    for scale, older in groups:
        sub = stratum(analysis, None if scale == "pooled" else scale, older, None)
        d = demean(sub); idx = valid_index(d, 1)
        vals = d[S].to_numpy(float)
        r = 100.0 * d["annual_change_rate"].to_numpy(float)[idx]
        yrs = d.year.to_numpy()[idx]; lv = sorted(np.unique(yrs))
        year_fe = np.column_stack([(yrs == v).astype(float) for v in lv[1:]])
        muni = d.muni_code.to_numpy()[idx]
        codes, inv = np.unique(muni, return_inverse=True)
        muni_rate = np.zeros(len(codes)); muni_rate[inv] = r
        muni_scale = np.empty(len(codes), dtype=object); muni_scale[inv] = d.city_scale.to_numpy()[idx]
        blocks = [np.flatnonzero(muni_scale == sc) for sc in np.unique(muni_scale)]
        large = (d.city_scale.to_numpy()[idx] == "Large").astype(float) if scale == "pooled" else None
        X1 = vals[idx - 1]; Y0 = vals[idx]                      # all sources at t-1, all targets at t

        def tmat(rr):
            T = np.full((14, 14), np.nan)
            for i, j in PAIR_INDEX:
                cols = [np.ones(len(idx)), X1[:, i], X1[:, j], X1[:, i] * rr, X1[:, j] * rr, rr, year_fe]
                if large is not None:
                    cols += [large, large * X1[:, i]]
                X = np.column_stack(cols)
                # classical t (same statistic for observed and permuted data; RI validity
                # does not depend on the SE estimator, and this is ~10x faster)
                XtX_inv = np.linalg.inv(X.T @ X); b = XtX_inv @ X.T @ Y0[:, j]
                u = Y0[:, j] - X @ b; s2 = float(u @ u) / (len(u) - X.shape[1])
                T[i, j] = b[3] / math.sqrt(s2 * XtX_inv[3, 3])
            return T
        T_obs = tmat(r)
        t_target = abs(T_obs[I, J])
        rank = int((np.abs(T_obs[~np.isnan(T_obs)]) >= t_target).sum())
        null_all, null_cs = np.empty(nperm), np.empty(nperm)
        for p in range(nperm):
            perm = muni_rate.copy()
            for m in blocks:
                perm[m] = muni_rate[m][rng.permutation(len(m))]
            Tp = tmat(perm[inv])
            null_all[p] = np.nanmax(np.abs(Tp)); null_cs[p] = np.nanmax(np.abs(Tp[I, :]))
        rows.append({"scale": scale, "cohort": "65+", "t_CS_x_rate": float(T_obs[I, J]), "rank_among_182": rank,
                     "p_family_CS13": mc_p(null_cs, t_target), "p_family_all182": mc_p(null_all, t_target),
                     "null_max_abs_t_all182_q50_q975": [float(np.quantile(null_all, .5)), float(np.quantile(null_all, .975))],
                     "null_max_abs_t_CS13_q50_q975": [float(np.quantile(null_cs, .5)), float(np.quantile(null_cs, .975))],
                     "nperm": nperm})
        print(f"[V9b {scale} 65+] |t| CS x rate = {t_target:.2f}, rank {rank}/182; family p CS13 {rows[-1]['p_family_CS13']:.3f}, "
              f"all182 {rows[-1]['p_family_all182']:.3f}", flush=True)
    save_table(out, "V9_dose_response_family.csv", rows, ["scale", "cohort"])


# ----------------------------------------------------------------------------
# run bookkeeping
# ----------------------------------------------------------------------------
def initialise_run(out, args):
    out.mkdir(parents=True, exist_ok=True)
    inputs = [args.xlsx] if args.xlsx else [args.data_csv, args.pop_csv]
    identity = {"version": __version__, "source_sha256": sha256(__file__), "input_sha256": [sha256(p) for p in inputs],
                "seed": args.seed, "window": args.window, "exclude_movers": args.exclude_movers,
                "pc_alpha": PC_ALPHA, "jitter": [JITTER_SEED, JITTER_SD]}
    versions = {n: importlib.metadata.version(n) for n in ("numpy", "pandas", "scipy", "tigramite")}
    path = out / "run_metadata.json"
    if path.exists():
        meta = json.loads(path.read_text(encoding="utf-8"))
        if meta["identity"] != identity:
            raise SystemExit("output directory belongs to different code/data/settings; choose a new --outdir")
        if meta["versions"] != versions:
            print(f"[warn] package versions differ from the first call: {meta['versions']} -> {versions}", flush=True)
    else:
        if any(out.iterdir()):
            raise SystemExit("non-empty output directory without run_metadata.json; choose a new --outdir")
        meta = {"created_utc": datetime.now(timezone.utc).isoformat(), "identity": identity, "versions": versions,
                "python": sys.version, "platform": platform.platform(), "calls": []}
    meta["calls"].append({"utc": datetime.now(timezone.utc).isoformat(), "steps": args.steps, "scales": args.scales,
                          "label_blocks": args.label_blocks, "nboot": args.nboot, "nrep_time": args.nrep_time, "nrep_label": args.nrep_label,
                          "rep_range": args.rep_range})
    write_json(path, meta)


def self_test():
    d = pd.DataFrame({"respondent_id": [1, 1, 1, 2, 2, 2, 2], "year": [2019, 2020, 2021, 2019, 2021, 2022, 2023]})
    assert valid_index(d, 1).tolist() == [1, 2, 5, 6]
    assert valid_index(d, 2).tolist() == [2, 6]
    assert mc_p(np.zeros(9), 1) == 0.1 and mc_two_tail(np.zeros(9), 1) == 0.2
    z = mci_conditioning_set({J: [(J, -1), (I, -1)], I: [(I, -1), (3, -1)]}, I, J)
    assert z == [(J, -1), (I, -2), (3, -2)]
    print("[self-test] OK", flush=True)


def main(argv=None):
    global HISTORY, REP_RANGE
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--xlsx"); ap.add_argument("--data-csv"); ap.add_argument("--pop-csv")
    ap.add_argument("--outdir", default="validation_v3")
    ap.add_argument("--steps", default="gate,diag,common,boot,ahiv,perm_time,perm_label,window_check,period_check,dose")
    ap.add_argument("--scales", default="SMC,Large")
    ap.add_argument("--window", choices=["lag1", "strict3"], default="lag1")
    ap.add_argument("--exclude-movers", action="store_true")
    ap.add_argument("--label-blocks", default="global,region")
    ap.add_argument("--nboot", type=int, default=2000)
    ap.add_argument("--nrep-time", type=int, default=500)
    ap.add_argument("--nrep-label", type=int, default=500)
    ap.add_argument("--seed", type=int, default=2026)
    ap.add_argument("--nperm-dose", type=int, default=2000, help="randomisation-inference permutations for V9")
    ap.add_argument("--force", action="store_true", help="continue past a failed Gate 1")
    ap.add_argument("--rep-range", default=None, help="START:END (END exclusive): compute only this slice of "
                    "replicates for perm_time/perm_label (parallel workers); aggregate with a run without it")
    args = ap.parse_args(argv)
    if args.rep_range:
        a, b = (int(x) for x in args.rep_range.split(":"))
        REP_RANGE = (a, b)
    else:
        REP_RANGE = None
    HISTORY = 1 if args.window == "lag1" else 2
    scales = tuple(s.strip() for s in args.scales.split(","))
    steps = set(s.strip() for s in args.steps.split(","))
    modes = [m.strip() for m in args.label_blocks.split(",")]
    unknown = steps - {"gate", "networks", "diag", "common", "boot", "ahiv", "perm_time", "perm_label", "window_check", "period_check", "dose", "dose_extra"}
    if unknown or set(scales) - set(SCALE_CODE) or set(modes) - {"global", "region", "prefecture"}:
        ap.error("unknown step / scale / label-block mode")
    out = Path(args.outdir).resolve()
    initialise_run(out, args); self_test()
    frame, analysis, flow = load_frame(args.xlsx, args.data_csv, args.pop_csv, args.exclude_movers)
    write_json(out / "sample_flow.json", flow)
    if "gate" in steps or not args.force:
        gate1(frame, out, force=args.force)
    if "networks" in steps:
        step_networks(frame, out, scales)
    need_fits = steps & {"diag", "common", "boot", "perm_time", "perm_label", "period_check"}
    if need_fits:
        fits = target_fits(analysis, out, scales)
        step_diag_common(analysis, fits, out, scales)
        if "boot" in steps: step_boot(fits, out, scales, args.nboot, args.seed)
        if "perm_time" in steps: step_perm_time(analysis, fits, out, scales, args.nrep_time, args.seed)
        if "perm_label" in steps: step_perm_label(analysis, fits, out, scales, args.nrep_label, args.seed, modes)
        if "period_check" in steps: step_period_check(fits, out, scales)
    if "ahiv" in steps: step_ahiv(analysis, out, scales)
    if "window_check" in steps: step_window_check(analysis, out, scales)
    if "dose" in steps:
        step_dose_response(analysis, out, scales, args.seed, args.nperm_dose)
        step_dose_family(analysis, out, scales, args.seed, max(100, args.nperm_dose // 4))
    if "dose" in steps or "dose_extra" in steps:
        step_dose_extra(analysis, out, scales, args.seed, args.nperm_dose)
    print(f"[done] {out}", flush=True)


if __name__ == "__main__":
    main()
