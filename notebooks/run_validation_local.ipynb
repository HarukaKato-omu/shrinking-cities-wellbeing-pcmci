def _clean_code(s):
    return s.astype("string").str.strip().str.replace(r"\.0$", "", regex=True).str.zfill(5)


def _map_columns(d, expected, canonical, name):
    if list(d.columns) == canonical:
        return d.copy()
    if list(d.columns) != expected:
        raise ValueError(f"{name}: unexpected columns. Expected {expected!r}, got {list(d.columns)!r}")
    d = d.copy()
    d.columns = canonical
    return d


def load_frame(xlsx=None, data_csv=None, pop_csv=None, exclude_movers=False):
    if xlsx:
        d = pd.read_excel(xlsx, sheet_name="24_分析データ")
        p = pd.read_excel(xlsx, sheet_name="17_Population")
    elif data_csv and pop_csv:
        d = pd.read_csv(data_csv, encoding="utf-8-sig")
        p = pd.read_csv(pop_csv, encoding="utf-8-sig")
    else:
        raise ValueError("supply --xlsx, or --data-csv and --pop-csv")
    d = _map_columns(d, ANALYSIS_HEADERS, ANALYSIS_COLS, "24_分析データ")
    p = _map_columns(p, POP_HEADERS, POP_COLS, "17_Population")
    source_rows = len(d)
    for c in ["PID", "year", "age_category"] + S + ["sex", "education", "household_income", "household_size"]:
        d[c] = pd.to_numeric(d[c], errors="coerce")
    d["muni_code"] = _clean_code(d["muni_code"])
    # movers: defined on all source waves (before complete-case deletion)
    n_muni = d.dropna(subset=["PID"]).groupby("PID")["muni_code"].nunique()
    mover_ids = set(n_muni[n_muni > 1].index) | set(d.loc[d["muni_code"].isna(), "PID"].dropna())
    for c in S:                                  # workbook codes 1..11 -> 0..10
        v = d[c] - 1.0
        d[c] = v.where(v.between(0, 10))
    unknown = set(d["city_type"].dropna().unique()) - set(CITY_SCALE)
    if unknown:
        raise ValueError(f"unknown CityType codes {unknown}")
    d["city_scale"] = d["city_type"].map(CITY_SCALE)
    # SCiRN shrinkage from total registered population, Eq. (1)
    p["muni_code"] = _clean_code(p["muni_code"])
    p["pop_year"] = pd.to_numeric(p["pop_year"], errors="coerce")
    p["population"] = pd.to_numeric(p["population"], errors="coerce")
    base = p[p.pop_year == POP_BASE_YEAR].drop_duplicates("muni_code").set_index("muni_code")["population"]
    end = p[p.pop_year == POP_END_YEAR].drop_duplicates("muni_code").set_index("muni_code")["population"]
    t = pd.DataFrame({"p0": base, "p1": end}).dropna()
    t = t[(t.p0 > 0) & (t.p1 > 0)]
    t["annual_change_rate"] = (t.p1 / t.p0) ** (1.0 / SHRINK_YEARS) - 1.0
    t["shrinking"] = (t.annual_change_rate <= SHRINK_THRESHOLD).astype(int)
    d = d.merge(t[["annual_change_rate", "shrinking"]], left_on="muni_code", right_index=True, how="left")
    d["age65plus"] = (d.age_category > 10).astype("Int64")
    d["survey_year"] = d.year
    d["covid_period"] = d.year.isin(COVID_YEARS).astype(float)
    need = ["PID", "year", "age_category", "city_type", "shrinking"] + S + ["sex", "education", "household_income", "household_size"]
    frame = d.dropna(subset=need).copy()
    if frame.duplicated(["PID", "year"]).any():
        raise ValueError("duplicate respondent-year records")
    # jitter: identical protocol to complete_pipeline.py (seed 42, column order, before final sort)
    rng = np.random.RandomState(JITTER_SEED)
    for c in JITTER_ORDER:
        frame[c] = frame[c].astype(float) + rng.normal(0.0, JITTER_SD, size=len(frame))
    frame = frame.rename(columns={"PID": "respondent_id"})
    frame["shrinking"] = frame["shrinking"].astype(int)
    frame["age65plus"] = frame["age65plus"].astype(int)
    frame["year"] = frame["year"].round().astype(int)
    frame = frame.sort_values(["respondent_id", "year"]).reset_index(drop=True)
    analysis = frame[~frame.respondent_id.isin(mover_ids)].reset_index(drop=True) if exclude_movers else frame
    flow = {"source_rows": source_rows, "complete_case_rows": len(frame),
            "complete_case_respondents": int(frame.respondent_id.nunique()),
            "movers_or_unknown_municipality_respondents": len(mover_ids),
            "exclude_movers": bool(exclude_movers),
            "analysis_rows": len(analysis), "analysis_respondents": int(analysis.respondent_id.nunique())}
    print(f"[read] complete cases {len(frame):,} rows / {frame.respondent_id.nunique():,} respondents; "
          f"analysis sample {len(analysis):,} rows ({'movers excluded' if exclude_movers else 'movers included'})", flush=True)
    return frame, analysis, flow


def count_valid_lag1(sub):
    ids = sub.respondent_id.to_numpy(); yrs = sub.year.to_numpy()
    return int(((ids[1:] == ids[:-1]) & (yrs[1:] == yrs[:-1] + 1)).sum())


def stratum(d, scale=None, older=None, shrink=None):
    m = pd.Series(True, index=d.index)
    if scale is not None: m &= d.city_scale == scale
    if older is not None: m &= d.age65plus == int(older)
    if shrink is not None: m &= d.shrinking == int(shrink)
    return d[m].sort_values(["respondent_id", "year"]).reset_index(drop=True)


def model_label(scale, older, shrink):
    return f"{ {None: 'All', True: 'Shrinking', False: 'Non-shrinking'}[shrink]} {SLAB[scale]}, aged {'65+' if older else '15-64'}"


def gate1(frame, out, force=False):
    rows, ok = [], True

    def check(name, got, exp, tol=0):
        nonlocal ok
        good = abs(got - exp) <= tol
        ok &= bool(good)
        rows.append({"item": name, "pipeline": got, "manuscript": exp, "match": "OK" if good else "CHECK"})

    check("person-years (total)", len(frame), TABLE1["person_years_total"])
    check("unique respondents (total)", frame.respondent_id.nunique(), TABLE1["respondents_total"])
    for scale in SCALES_ALL:
        for shrink, key in ((None, scale), (True, "Shrink" + scale)):
            sub = stratum(frame, scale, None, shrink); t = TABLE1[key]
            tag = ("" if shrink is None else "Shrinking ") + scale
            if shrink is None:
                check(f"{tag}: municipalities", sub.muni_code.nunique(), t["munis"])
                check(f"{tag}: shrinking municipalities", sub.loc[sub.shrinking == 1, "muni_code"].nunique(), t["shrinking_munis"])
            check(f"{tag}: person-years", len(sub), t["person_years"])
            check(f"{tag}: unique respondents", sub.respondent_id.nunique(), t["respondents"])
            med = sub.groupby("muni_code")["annual_change_rate"].first().median()
            check(f"{tag}: median annual change (%/yr)", round(100 * med, 2), t["median_r"], tol=0.005)
            check(f"{tag}: valid lag-1 transitions (total)", count_valid_lag1(sub), t["trans_total"])
            check(f"{tag}: valid transitions (15-64)", count_valid_lag1(stratum(frame, scale, False, shrink)), t["trans_1564"])
            check(f"{tag}: valid transitions (65+)", count_valid_lag1(stratum(frame, scale, True, shrink)), t["trans_65"])
    save_table(out, "G1_table1_check.csv", rows)
    n_bad = sum(r["match"] != "OK" for r in rows)
    print(f"[gate 1] {len(rows) - n_bad}/{len(rows)} items match manuscript Table 1", flush=True)
    if not ok and not force:
        raise SystemExit("Gate 1 failed: the workbook does not reproduce Table 1 (use --force to override)")
    return ok


# ----------------------------------------------------------------------------
# estimation primitives
# ----------------------------------------------------------------------------
def restrict_min_waves(sub):
    n = sub.groupby("respondent_id").year.transform("size")
    return sub[n >= MIN_WAVES].copy().reset_index(drop=True)


def demean(sub):
    sub = restrict_min_waves(sub)
    sub[S] = sub[S] - sub.groupby("respondent_id")[S].transform("mean")
    return sub.sort_values(["respondent_id", "year"]).reset_index(drop=True)


def valid_index(d, history=None):
    """Rows t whose previous `history` rows are the same respondent in consecutive years."""
    history = HISTORY if history is None else history
    if len(d) <= history:
        return np.array([], dtype=int)
    ids, yrs = d.respondent_id.to_numpy(), d.year.to_numpy()
    idx = np.arange(history, len(d))
    good = np.ones(len(idx), bool)
    for lag in range(1, history + 1):
        good &= (ids[idx] == ids[idx - lag]) & (yrs[idx] - yrs[idx - lag] == lag)
    return idx[good]


def transition_mask(sub):
    mask = np.ones((len(sub), len(ALL)), dtype=bool)
    mask[valid_index(sub)] = False
    return mask


@dataclass
class Fit:
    sub: pd.DataFrame
    val: np.ndarray
    p: np.ndarray
    n: int
    parents: dict


def mci_conditioning_set(parents, i, j, tau=1):
    """Replicates tigramite._iter_indep_conds: parents(Y) minus X, plus shifted parents(X)."""
    z = [node for node in parents[j] if node != (i, -tau)]
    for k, lag in parents[i]:
        node = (k, lag - tau)
        if node not in z:
            z.append(node)
    return z


def union_set(fa, fb, i=I, j=J):
    za = mci_conditioning_set(fa.parents, i, j)
    return za + [n for n in mci_conditioning_set(fb.parents, i, j) if n not in za]


def zname(z):
    return [f"{ALL[k]}({lag})" for k, lag in z]


def aligned_array(d, i, j, z):
    """Design for X(t-1), Y(t), Z as Tigramite builds it under mask_type='y':
    rows = valid transitions with t >= max lag; lagged values are read at
    t+lag.  Under --window lag1 a lag-2 condition can therefore cross a
    respondent boundary (this reproduces the manuscript); under strict3 it
    cannot.  Returns (array, row_index)."""
    nodes = [(i, -1), (j, 0)] + list(z)
    maxlag = max(-lag for _, lag in nodes)
    idx = valid_index(d)
    idx = idx[idx - maxlag >= 0]
    values = d[ALL].to_numpy(float)
    a = np.column_stack([values[idx + lag, k] for k, lag in nodes])
    return a, idx


def partial_corr_array(a):
    a = a - a.mean(axis=0)
    sd = a.std(axis=0); sd[sd == 0] = 1.0
    a = a / sd
    xy, z = a[:, :2], a[:, 2:]
    if z.shape[1]:
        xy = xy - z @ np.linalg.lstsq(z, xy, rcond=None)[0]
    return float(np.corrcoef(xy.T)[0, 1])


def parcorr_masked(d, x, y, z):
    a, idx = aligned_array(d, ALL.index(x), ALL.index(y), z)
    return partial_corr_array(a), len(idx)


def run_model_with_parents(sub):
    data = sub[ALL].to_numpy(float)
    if not np.isfinite(data).all():
        raise ValueError("non-finite model inputs")
    idx = valid_index(sub)
    if len(sub) < 25 or len(idx) < 10:
        raise ValueError(f"stratum too small (rows={len(sub)}, valid={len(idx)})")
    tdf = TigDataFrame(data, mask=transition_mask(sub), var_names=ALL)
    # Tigramite drops the first 2*tau_max rows in the PC phase (cut_off='2xtau_max'),
    # so its sample may be up to 2 rows smaller than the mask count that the
    # manuscript reports as n_valid; anything else indicates a mask error.
    array, _, _ = tdf.construct_array(X=[(I, -1)], Y=[(J, 0)], Z=[], tau_max=TAU_MAX, mask_type="y")
    if not (len(idx) - 2 <= array.shape[1] <= len(idx)):
        raise AssertionError(f"Tigramite sample {array.shape[1]} != mask sample {len(idx)}")
    pcmci = PCMCI(dataframe=tdf, cond_ind_test=ParCorr(significance="analytic", mask_type="y"), verbosity=0)
    res = pcmci.run_pcmci(tau_min=TAU_MIN, tau_max=TAU_MAX, pc_alpha=PC_ALPHA)
    fit = Fit(sub, res["val_matrix"], res["p_matrix"], len(idx), pcmci.all_parents)
    check, _ = parcorr_masked(sub, CS, WLB, mci_conditioning_set(fit.parents, I, J))
    if not np.isclose(check, fit.val[I, J, 1], atol=1e-8):
        raise AssertionError(f"fixed-set partial correlation {check} != Tigramite MCI {fit.val[I, J, 1]}")
    return fit


def cached_fit(sub, out, key):
    path = Path(out) / "checkpoints" / "fits" / f"{key}.npz"
    if path.exists():
        with np.load(path, allow_pickle=False) as zf:
            parents = {int(k): [tuple(v) for v in vs] for k, vs in json.loads(str(zf["parents"])).items()}
            fit = Fit(sub, zf["val"], zf["p"], int(zf["n"]), parents)
        if fit.n != len(valid_index(sub)):
            raise AssertionError("cached fit does not match the current sample")
        return fit
    fit = run_model_with_parents(sub)
    write_npz(path, val=fit.val, p=fit.p, n=fit.n, parents=np.asarray(json.dumps(json_ready(fit.parents))))
    return fit


def bh_qvalues_lag1(p):
    ps = np.asarray([p[i, j, 1] for i, j in PAIR_INDEX])
    order = np.argsort(ps)
    qs = np.minimum.accumulate((ps[order] * len(ps) / np.arange(1, len(ps) + 1))[::-1])[::-1]
    q = np.empty_like(ps); q[order] = np.minimum(qs, 1.0)
    m = np.full((14, 14), np.nan)
    for (i, j), v in zip(PAIR_INDEX, q):
        m[i, j] = v
    return m


def reported_edges(fit, floor=MCI_FLOOR):
    q = bh_qvalues_lag1(fit.p)
    return [(i, j) for i, j in PAIR_INDEX if q[i, j] < Q_THRESHOLD and abs(fit.val[i, j, 1]) >= floor]


def out_strength(fit, floor=MCI_FLOOR):
    s = {}
    for i, j in reported_edges(fit, floor):
        s[S[i]] = s.get(S[i], 0.0) + abs(fit.val[i, j, 1])
    return s


# ----------------------------------------------------------------------------
# contrast statistics (both conventions) and families
# ----------------------------------------------------------------------------
def z_matrix_paper(fs, fn):
    """Model-specific MCI (Table 7 convention)."""
    Z = np.full((14, 14), np.nan)
    for i, j in PAIR_INDEX:
        Z[i, j] = fisher_z(fs.val[i, j, 1], fs.n, fn.val[i, j, 1], fn.n)[0]
    return Z


def z_matrix_union(fs, fn):
    """Both subsets re-estimated under the union of their MCI conditioning sets."""
    Z = np.full((14, 14), np.nan); RS = Z.copy(); RN = Z.copy()
    for i, j in PAIR_INDEX:
        z = union_set(fs, fn, i, j)
        r1, n1 = parcorr_masked(fs.sub, S[i], S[j], z)
        r2, n2 = parcorr_masked(fn.sub, S[i], S[j], z)
        RS[i, j], RN[i, j], Z[i, j] = r1, r2, fisher_z(r1, n1, r2, n2)[0]
    return Z, RS, RN


def family_stats(Z, selected):
    out = {f"max_abs_z_{name}": float(np.nanmax([abs(Z[i, j]) for i, j in edges])) for name, edges in FAMILIES.items()}
    out["max_abs_z_paper_rule"] = float(max([abs(Z[i, j]) for i, j in selected], default=0.0))
    out["n_reported_edges_s"] = len(selected)
    return out


def contrast_metrics(fs, fn, want_union=True):
    Zp = z_matrix_paper(fs, fn)
    selected = reported_edges(fs)
    row = {"z_paper": float(Zp[I, J]), "mci_s": float(fs.val[I, J, 1]), "mci_n": float(fn.val[I, J, 1]),
           "n_s": fs.n, "n_n": fn.n}
    row.update({f"paper__{k}": v for k, v in family_stats(Zp, selected).items()})
    Zu = None
    if want_union:
        Zu, RS, RN = z_matrix_union(fs, fn)
        row.update({"z_union": float(Zu[I, J]), "r_s_union": float(RS[I, J]), "r_n_union": float(RN[I, J])})
        row.update({f"union__{k}": v for k, v in family_stats(Zu, selected).items() if k != "n_reported_edges_s"})
    return row, Zp, Zu


def perm_pvalues(null: pd.DataFrame, obs: dict, prefix: str):
    """Permutation p-values for the single edge under each family, both conventions."""
    res = {}
    for conv in ("paper", "union"):
        zcol = f"z_{conv}"
        if zcol not in null.columns or zcol not in obs:
            continue
        target = abs(obs[zcol])
        res[f"{conv}__p_single_edge"] = mc_p(null[zcol].abs(), target)
        for fam in ("CS13", "care50", "all182"):
            res[f"{conv}__p_family_{fam}"] = mc_p(null[f"{conv}__max_abs_z_{fam}"], target)
        res[f"{conv}__p_paper_selection_rule"] = mc_p(null[f"{conv}__max_abs_z_paper_rule"], obs[f"{conv}__max_abs_z_paper_rule"])
        res[f"{conv}__p_network_omnibus"] = mc_p(null[f"{conv}__max_abs_z_all182"], obs[f"{conv}__max_abs_z_all182"])
    res["p_mci_s_two_tail"] = mc_two_tail(null["mci_s"], obs["mci_s"])
    res["p_mci_n_two_tail"] = mc_two_tail(null["mci_n"], obs["mci_n"])
    res["minimum_MC_p"] = 1 / (len(null) + 1)
    return {f"{prefix}{k}": v for k, v in res.items()}


